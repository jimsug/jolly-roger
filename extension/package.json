{
  "name": "jolly-roger-browser-extension",
  "version": "1.0.0",
  "description": "Browser extension for use with Jolly Roger",
  "scripts": {
    "watch": "webpack --config webpack/webpack.dev.mjs --watch",
    "build": "webpack --config webpack/webpack.prod.mjs",
    "clean": "rimraf dist",
    "lint": "npm run lint:oxlint && npm run lint:eslint && npm run lint:biome && npm run lint:types && npm run lint:knip",
    "lint:oxlint": "oxlint -c oxlint.jsonc --tsconfig tsconfig.json --type-aware --deny-warnings --report-unused-disable-directives",
    "lint:eslint": "eslint -c ../eslint.config.mts --max-warnings 0 src",
    "lint:biome": "biome check",
    "lint:types": "tsc -p tsconfig.json --noEmit",
    "lint:knip": "knip"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "bootstrap": "^5.3.3",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.6",
    "react-dom": "^19.3.0",
    "react-select": "^5.9.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/stylis": "^4.2.7",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "rimraf": "^6.0.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.1.0",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^6.0.1",
    "zip-webpack-plugin": "^4.0.3"
  }
}
