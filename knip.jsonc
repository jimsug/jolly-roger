{
  "$schema": "https://unpkg.com/knip@5/schema-jsonc.json",
  "entry": [
    "{client,server,tests}/main.ts",
    "client/**/*.scss",
    "private/google-script/main.js",
    // knip can't follow dynamic imports
    "tests/**"
  ],
  "project": ["**/*", "!.meteor/local/**", "!eslint/dist/**"],
  "rules": {
    // TODO: We may want to enable these later, as they're potentially indicative of dead code
    "exports": "off",
    "types": "off"
  },
  // We're using SWC, but we don't depend on it directly because it's provided by meteor
  "swc": {},
  // Because we're using tsgo, knip will by default ignore our tsconfig.json
  "typescript": {},
  "ignoreBinaries": ["meteor"],
  "ignoreDependencies": [
    // Detected and used by Meteor
    "@babel/runtime",
    "meteor-node-stubs",
    // Detected and used by fourseven:scss
    "sass",
    // Detected and used by mongodb
    "aws4",
    // Used by test suite
    "playwright",
    // Used by extension build
    "zip-webpack-plugin",
    // Used in later commits (chat reactions)
    "emoji-picker-react"
  ],
  "ignore": [
    // Meteor publications and methods are registered dynamically at runtime
    "imports/lib/publications/**",
    "imports/methods/**",
    "imports/server/publications/**",
    "imports/server/methods/**",
    "imports/server/api/resources/**",
    // Extension is a separate project with its own build
    "extension/**",
    // Used by API routes
    "imports/server/findPuzzles.ts",
    // Dynamically imported in Routes.tsx
    "imports/client/components/HuntPurgePage.tsx",
    "imports/client/components/InvitedUserList.tsx",
    "imports/client/components/MoreAppPage.tsx",
    // User history feature (connected via Routes in later commits)
    "imports/client/ActivityHistorySummaries.ts",
    "imports/client/components/ContributionGraph.tsx",
    "imports/client/components/UserHistoryPage.tsx",
    "imports/client/PuzzleHistorySummaries.ts"
  ],
  "tags": ["-lintignore"]
}
